NODE_ENV=development
PORT=3000
CORS_ORIGINS=*
LOG_LEVEL=debug
TIMEZONE=Europe/Paris

DATABASE_URL=postgresql://moodmap:moodmap@localhost:2054/moodmap?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Facultatif : clé dédiée au chiffrement des secrets de double authentification.
# TWO_FACTOR_SECRET_KEY=change-me-two-factor-key-at-least-32-chars

RESET_TOKEN_TTL_MINUTES=30
APP_URL=http://localhost:8081

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mood Map <no-reply@moodmap.app>"

MOOD_MIN_RESPONSES=3

# Facultatif : contacts d'aide propres à l'entreprise, affichés avec le 3114.
# SUPPORT_RESOURCES=[{"label":"Psychologue d'entreprise","phone":"01 23 45 67 89","description":"Consultation confidentielle"}]

ENABLE_JOBS=true
CRON_SNAPSHOTS=*/15 * * * *
CRON_DAILY_REMINDER=0 17 * * 1-5

SEED_PASSWORD=MoodMap2026!

# Facultatif : ajouter des réponses fictives uniquement pour une démo explicite.
SEED_DEMO_MOODS=false
